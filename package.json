{
  "name": "roamwise-ai-trip-planner",
  "version": "1.0.0",
  "description": "Production-grade AI Trip Planner turning unstructured text prompts into stateful, interactive itineraries with robust AI failure handling.",
  "type": "module",
  "main": "server/index.js",
  "scripts": {
    "start": "concurrently -n \"SERVER,CLIENT\" -c \"cyan,magenta\" \"npm run server\" \"npm run client\"",
    "dev": "concurrently -n \"SERVER,CLIENT\" -c \"cyan,magenta\" \"npm run server\" \"npm run client\"",
    "server": "node server/index.js",
    "client": "vite --port 5173",
    "build": "vite build",
    "preview": "vite preview"
  },
  "keywords": [
    "react",
    "ai",
    "groq",
    "itinerary",
    "trip-planner",
    "stateful-ui"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "canvas-confetti": "^1.9.4",
    "cors": "^2.8.6",
    "dotenv": "^18.0.3",
    "express": "^5.2.1",
    "groq-sdk": "^1.6.0",
    "lucide-react": "^1.48.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "vite": "^8.3.1"
  }
}
